# Flood exposure, coping strategies and psychological distress
# Data: Sunamganj and Sylhet, 2022 flood survey

# install.packages(c("haven", "dplyr", "ggplot2", "patchwork", "ragg"))

library(haven)
library(dplyr)
library(ggplot2)
library(patchwork)

# Keep the data file next to this script, or change the path here
SAV <- " "
FAM <- "Times New Roman"
OUT <- "Figure3_Flood_Exposure_Distress"

# Data input
d   <- read_sav(SAV)
num <- function(x) suppressWarnings(as.numeric(as.character(x)))
yn  <- function(x) { x <- as.numeric(x); ifelse(x == 1, 1, ifelse(x == 2, 0, NA)) }

# To calculate distress score: Need mean of the 11 Section 7 items (1-4) then rescaled to 0-100
items <- as.data.frame(lapply(d[paste0("S7Q", 1:11)], function(x) {
  x <- as.numeric(x); x[!x %in% 1:4] <- NA; x }))
dist <- ifelse(rowSums(!is.na(items)) >= 9,
               (rowMeans(items, na.rm = TRUE) - 1) / 3 * 100, NA)
